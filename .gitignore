# This is a monorepo with no shared root tooling (see CLAUDE.md) — server/
# and client/ each have their own .gitignore for their own node_modules/
# dist/uploads/etc. This root one only needs to cover root-level files.

# Environment variables
.env
.env.*
!.env.example

# In case anything is ever installed/built at the root
node_modules/
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
